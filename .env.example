# Aura Skincare AI Voice Agent — Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env.local to version control.

# Google Gemini API Key (Server-side only).
# Obtained from Google AI Studio (https://aistudio.google.com).
# If absent or free quota is exhausted, Aria automatically operates on the deterministic policy & catalog engine.
GEMINI_API_KEY=

# Optional: Override default Gemini model identifier (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
